# Postgres (Neon). Used by apps/server and drizzle-kit.
DATABASE_URL=postgres://user:password@localhost:5432/idem

# Socket server
PORT=8787
HOST=0.0.0.0

# Browser-visible URL of the socket server
NEXT_PUBLIC_WS_URL=ws://localhost:8787

# Auth.js v5 (M11). Generate a secret with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
